# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Google Spreadsheet used as the database (the long ID in the sheet URL).
SHEET_ID=

# Service account (Google Cloud → IAM → Service accounts → Keys → JSON).
# Share the spreadsheet with this email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON, keeping the \n sequences, wrapped in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Auth.js (Google Sign-In). Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Backup: URL of the deployed apps-script/Backup.gs web app + the shared secret you set there.
BACKUP_WEBAPP_URL=
BACKUP_SECRET=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/backup.
CRON_SECRET=
